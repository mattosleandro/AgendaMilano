# Domínio público da aplicação
NEXT_PUBLIC_APP_URL=https://agenda.portalmilano.com

# Supabase autohospedado (Gateway público de referência e rede Docker interna)
NEXT_PUBLIC_SUPABASE_URL=https://api.portalmilano.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=substituir_pela_anon_key

# Uso exclusivo server-side (Next.js -> Envoy via milano_net)
SUPABASE_INTERNAL_URL=http://supabase-envoy:8000
SUPABASE_SERVICE_ROLE_KEY=substituir_pela_service_role_key

# Segredo criptográfico (mínimo 32 caracteres aleatórios) para assinatura de cookies HttpOnly
SESSION_SECRET=substituir_por_segredo_aleatorio_minimo_32_caracteres

# Fuso horário oficial do condomínio
APP_TIMEZONE=America/Campo_Grande
